# Copy this file to app/.env and fill in your values:
#   cp .env.example app/.env
# NEVER commit your actual app/.env file to Git! (it is git-ignored)

# PostHog: PUBLIC project token (starts with phc_) and host. Never a personal API key.
VITE_POSTHOG_KEY=phc_replace-with-your-project-token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Gemini (AI brief). SECRET: lives only in app/.env, read by the local server (app/server), never by the browser.
GEMINI_API_KEY=replace-with-your-gemini-key
# Optional: model, token limit and paid-tier prices per 1M tokens (used to show cost per run)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4000
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50

# Google sign-in + read-only Calendar (local server only). SECRET: never in the browser or Git.
# Redirect URI to register in Google Cloud: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Abuse protection (Build 3)
# Monthly AI budget for the whole app (estimated USD). AI routes answer 429 once it is reached.
AI_MONTHLY_BUDGET_USD=5
# Set to 1 only when running behind a hosting proxy (Render), so rate limits use the visitor's real IP.
TRUST_PROXY=0
